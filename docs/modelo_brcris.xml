			<field name="startDate"/> <!-- somente ano -->
			<field name="endDate"/> <!-- somente ano -->
		</entity>
		<entity name="Program">
			<field name="identifier.brcris"/> <!-- hash de nome do programa + nome da instituicao (md5) -->
