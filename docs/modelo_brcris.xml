<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<entity-relation-metamodel>
	<entities>
		<entity name="Person">
			<field name="identifier.brcris"/> <!-- será o lattes (sem url) com md5 -->
			<field name="identifier.lattes"/> <!-- sem url e único-->
			<field name="identifier.lattesShort"/> <!-- sem url e único-->
			<field name="identifier.cpf"/>
			<field name="identifier.email" description="identificador único e-mail"/> <!-- se houver, verificar se é válido (@)-->
			<field name="identifier.orcid"/> <!-- sem url, único, validado com hifens e checando o digito verificador -->
			<field name="identifier.researcherID"/>
			<field name="identifier.scopusAuthorID"/>
			<field name="identifier.cienciaID"/>
			<field name="identifier.capes"/> <!-- id numérico -->
			<field name="identifier.openalex"/> <!-- alfanumérico, sem url, único -->
			<field name="identifier.dark"/>
			<field name="identifier.other"/>
			<field name="name" description="nome da pessoa"/> <!-- usar o do nome do currículo (com maior grau de confiança) -->
			<field name="alternateName"/>
			<field name="citationName"/> <!-- usar os nomes de citaçoes do currículo (com maior grau de confiança) -->
			<field name="gender"/>
			<field name="birthDate"/>
			<field name="birthCountry"/> <!-- validar na lista de autoridade de país -->
			<field name="birthState"/> <!-- validar na lista de autoridade de estado -->
			<field name="birthCity"/> <!-- validar na lista de autoridade de cidade -->
			<field name="nationality"/> 
			<field name="researchArea"/> <!-- nao precisa validar na lista de autoridade, mas deve ser captalizado corretamente. Deve concatenar toda a árvore em uma estrutura de diretorios. Ex.: Grande Area / Area / Sub-area / Especialidade -->
