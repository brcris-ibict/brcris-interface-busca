			<field name="eventName"/> <!-- caso seja uma publicacao em anais de eventos -->
		</entity>
		<entity name="Journal">
			<field name="identifier.issn" description="ISSN"/> <!-- Usar o padrao XXXX-XXXX -->
			<field name="identifier.issn_l" description="ISSN-L"/> <!-- Usar o padrao XXXX-XXXX -->
