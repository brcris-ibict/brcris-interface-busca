			<field name="publicationDate"/> <!-- somente ano -->
			<field name="degreeDate"/>
			<field name="number"/>
			<field name="volume"/>
			<field name="issue"/>
			<field name="series"/>
			<field name="edition"/>
			<field name="startPage"/>
			<field name="endPage"/>
			<field name="author"/>
			<field name="advisor"/>
			<field name="coadvisor"/>
